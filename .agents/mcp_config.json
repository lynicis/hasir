{
    "mcpServers": {
        "typescript-lsp": {
            "command": "./.agents/bin/ts-lsp"
        },
        "go-lsp": {
            "command": "./.agents/bin/go-lsp"
        },
        "postgresql": {
            "command": "uvx",
            "args": [
                "postgres-mcp",
                "--access-mode=unrestricted"
            ],
            "env": {
                "DATABASE_URI": "postgresql://test:test@localhost:5432/test"
            }
        },
        "shadcn": {
            "command": "bunx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "next-devtools": {
            "command": "bunx",
            "args": [
                "-y",
                "next-devtools-mcp@latest"
            ]
        }
    }
}