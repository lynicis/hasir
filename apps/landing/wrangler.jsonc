{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hasir-landing",
  "compatibility_date": "2026-11-19",
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "hasir.lynicis.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
