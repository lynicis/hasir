{
  "name": "hasir-monorepo",
  "version": "1.1.1",
  "private": true,
  "description": "Hasir platform monorepo — Go API + Next.js dashboard + shared protobuf contracts, Helm charts, and Docker images.",
  "license": "MIT",
  "author": {
    "name": "Emre Sırmalı",
    "url": "https://lynicis.dev",
    "email": "me@lynicis.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lynicis/hasir"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "deploy/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "proto": "turbo run proto",
    "generate": "turbo run generate",
    "docker": "turbo run docker",
    "format": "turbo run format",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "affected:build": "turbo run build --affected",
    "affected:test": "turbo run test --affected",
    "affected:lint": "turbo run lint --affected",
    "vuln": "turbo run vuln",
    "release": "touch \"${CHANGESETS_OUTPUT:-/dev/null}\" && changeset publish",
    "design:lint": "designmd lint DESIGN.md"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@changesets/cli": "^3.0.3",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@connectrpc/protoc-gen-connect-query": "^2.3.1",
    "@eslint/js": "^9.39.5",
    "@google/design.md": "^0.4.0",
    "@hasir/eslint-config": "workspace:*",
    "@hasir/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-perfectionist": "^5.11.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "@hono/node-server": ">=2.0.5",
    "fast-uri": ">=3.1.4",
    "next": "16.3.5",
    "sharp": ">=0.35.0"
  },
  "trustedDependencies": [
    "@bufbuild/buf",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "next": "16.3.5"
  }
}